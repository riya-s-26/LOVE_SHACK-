# ============================================================================
# THE LOVE SHACK — .gitignore
# Prevents sensitive credentials, environment files, and local logs from git
# ============================================================================

# Private Database & Environment Credentials
config/config.php
*.env
.env.*

# Local scratch and temporary files
scratch/
_backup/
*.tmp
*.bak
*.swp

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor folders
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Server & application logs
*.log
error_log
